{
  "name": "3d-studio",
  "version": "0.1.0",
  "description": "Open source desktop app to create and edit 3D-printable models by hand or through AI chat, with live preview.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.3dstudio.app",
    "productName": "3D Studio",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "3mf",
        "name": "3MF model",
        "role": "Editor"
      },
      {
        "ext": "stl",
        "name": "STL model",
        "role": "Editor"
      },
      {
        "ext": "scad",
        "name": "OpenSCAD model",
        "role": "Editor"
      }
    ]
  }
}
